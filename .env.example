# Copy this file to .env and fill in the values. Never commit .env.
# The scripts read these; the website needs none of them.

# NEAR mainnet account that owns and runs your Sphinx contract (seller in the proof run)
MAINNET_ACCOUNT_ID=
MAINNET_PRIVATE_KEY=

# Optional: a second account used as the buyer in scripts/e2e.mjs
# (created and saved here automatically if left empty)
MAINNET_BUYER_ACCOUNT_ID=
MAINNET_BUYER_PRIVATE_KEY=
